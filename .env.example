# ── Database (Turso / libSQL) ─────────────────────────────────────────────
# Production: create a DB at https://turso.tech and paste its URL + token.
#   TURSO_DATABASE_URL=libsql://your-db-name.turso.io
#   TURSO_AUTH_TOKEN=your-token
# Local dev: leave the token blank and point the URL at a local file.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# ── Authentication ────────────────────────────────────────────────────────
# Used to sign httpOnly session cookies. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=change-me-in-production

# ── Web Push Notifications ────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Shared secret for external schedulers calling POST /api/push/dispatch.
CRON_SECRET=change-me-before-using-notifications
APP_TIMEZONE=Asia/Bangkok
EVENT_REMINDER_LEAD_MINUTES=10

# ── AI Assistant (Groq, OpenAI-compatible API) ────────────────────────────
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Any Groq-hosted model id. Defaults to a GPT-class model if unset.
GROQ_MODEL=openai/gpt-oss-120b
