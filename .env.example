# ── Database (Turso / libSQL) ─────────────────────────────────────────────
# Production: create a DB at https://turso.tech and paste its URL + token.
#   TURSO_DATABASE_URL=libsql://your-db-name.turso.io
#   TURSO_AUTH_TOKEN=your-token
# Local dev: leave the token blank and point the URL at a local file.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# ── AI Assistant (Groq, OpenAI-compatible API) ────────────────────────────
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Any Groq-hosted model id. Defaults to a GPT-class model if unset.
GROQ_MODEL=openai/gpt-oss-120b
